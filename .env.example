# public — shipped to the browser, used only for Realtime subscribe
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# server only — never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
APP_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# public origin, used by `pnpm create-household` to print the join link
APP_URL=http://localhost:3000

# local development only, used by `pnpm seed` and the SQL equivalence test
SUPABASE_DB_URL=

# a join path of a throwaway household, only for `pnpm test:e2e`
E2E_JOIN_PATH=
